"VMMaker.oscog-cb.3824: bound writes to the 512-byte mapBuffer in generateMapAt:limit:start:. Fixes stack buffer underflow when a method's annotation map exceeds 512 bytes."!!Cogit methodsFor: 'generate machine code' stamp: 'cb 10/26/2026 23:12'!generateCogFullBlock	"We handle jump sizing simply.  First we make a pass that asks each	 instruction to compute its maximum size.  Then we make a pass that	 sizes jumps based on the maxmimum sizes.  Then we make a pass	 that fixes up jumps.  When fixing up a jump the jump is not allowed to	 choose a smaller offset but must stick to the size set in the second pass.	 Uses a single-pass annotation map generated into a 512-byte stack buffer to	 eliminate the preliminary generateMapAt: nil pass."	<returnTypeC: #'CogMethod *'>	<option: #SistaV1BytecodeSet>	| codeSize headerSize mapSize totalSize startAddress result method mapBuffer |	<var: #method type: #'CogMethod *'>	<var: #mapBuffer declareC: 'char mapBuffer[512]'>	headerSize := self sizeof: CogMethod.	methodLabel address: methodZone freeStart.	self computeMaximumSizes.	methodLabel concretizeAt: methodZone freeStart.	codeSize := self generateInstructionsAt: methodLabel address + headerSize.	mapSize := self generateMapAt: (self cCode: '(usqInt)(mapBuffer + 511 - codeToDataDelta)'									inSmalltalk: [nil])					limit: 512					start: methodLabel address + cbNoSwitchEntryOffset.	totalSize := methodZone roundUpLength: headerSize + codeSize + mapSize.	totalSize > MaxMethodSize ifTrue:		[^self cCoerceSimple: MethodTooBig to: #'CogMethod *'].	startAddress := methodZone allocate: totalSize.	startAddress = 0 ifTrue:		[^self cCoerceSimple: InsufficientCodeSpace to: #'CogMethod *'].	self assert: startAddress + cbEntryOffset = fullBlockEntry address.	self assert: startAddress + cbNoSwitchEntryOffset = fullBlockNoContextSwitchEntry address.	result := self outputInstructionsAt: startAddress + headerSize.	self assert: startAddress + headerSize + codeSize = result.	backEnd padIfPossibleWithStopsFrom: result to: startAddress + totalSize - mapSize - 1.	(self cCode: [mapSize <= 512] inSmalltalk: [false])		ifTrue:			[self codeMemmove: startAddress + totalSize - mapSize				_: (self cCode: 'mapBuffer + 512 - mapSize')				_: mapSize]		ifFalse:			[self generateMapAt: startAddress + totalSize - 1 start: startAddress + cbNoSwitchEntryOffset].	self flag: #TOCHECK. "It's not clear we want the same header than regular methods. 	It could be of the same size, but maybe the cmType could be different and the selector could be ignored." 	method := self writableMethodFor: startAddress.	self fillInMethodHeader: method size: totalSize selector: objectMemory nilObject.	method cpicHasMNUCaseOrCMIsFullBlock: true.		"This also implicitly flushes the read/write mapped dual zone to the read/execute zone."	backEnd flushICacheFrom: startAddress to: startAddress + totalSize.	^self cCoerceSimple: startAddress to: #'CogMethod *'! !!Cogit methodsFor: 'generate machine code' stamp: 'cb 10/26/2026 23:12'!generateCogMethod: selector	"We handle jump sizing simply.  First we make a pass that asks each	 instruction to compute its maximum size.  Then we make a pass that	 sizes jumps based on the maxmimum sizes.  Then we make a pass	 that fixes up jumps.  When fixing up a jump the jump is not allowed to	 choose a smaller offset but must stick to the size set in the second pass.	 Uses a single-pass annotation map generated into a 512-byte stack buffer to	 eliminate the preliminary generateMapAt: nil pass."	<returnTypeC: #'CogMethod *'>	| codeSize headerSize mapSize totalSize startAddress result mapBuffer |	<var: #mapBuffer declareC: 'char mapBuffer[512]'>	headerSize := self sizeof: CogMethod.	methodLabel address: methodZone freeStart.	self computeMaximumSizes.	methodLabel concretizeAt: methodZone freeStart.	codeSize := self generateInstructionsAt: methodLabel address + headerSize.	mapSize := self generateMapAt: (self cCode: '(usqInt)(mapBuffer + 511 - codeToDataDelta)'									inSmalltalk: [nil])					limit: 512					start: methodLabel address + cmNoCheckEntryOffset.	totalSize := methodZone roundUpLength: headerSize + codeSize + mapSize.	totalSize > MaxMethodSize ifTrue:		[^self cCoerceSimple: MethodTooBig to: #'CogMethod *'].	startAddress := methodZone allocate: totalSize.	startAddress = 0 ifTrue:		[^self cCoerceSimple: InsufficientCodeSpace to: #'CogMethod *'].	self assert: startAddress + cmEntryOffset = entry address.	self assert: startAddress + cmNoCheckEntryOffset = noCheckEntry address.	result := self outputInstructionsAt: startAddress + headerSize.	self assert: startAddress + headerSize + codeSize = result.	backEnd padIfPossibleWithStopsFrom: result to: startAddress + totalSize - mapSize - 1.	(self cCode: [mapSize <= 512] inSmalltalk: [false])		ifTrue:			[self codeMemmove: startAddress + totalSize - mapSize				_: (self cCode: 'mapBuffer + 512 - mapSize')				_: mapSize]		ifFalse:			[self generateMapAt: startAddress + totalSize - 1 start: startAddress + cmNoCheckEntryOffset].	self fillInBlockHeadersAt: startAddress.	self fillInMethodHeader: (self writableMethodFor: startAddress)		size: totalSize		selector: selector.	"This also implicitly flushes the read/write mapped dual zone to the read/execute zone."	backEnd flushICacheFrom: startAddress to: startAddress + totalSize.	^self cCoerceSimple: startAddress to: #'CogMethod *'! !!Cogit methodsFor: 'method map' stamp: 'cb 10/26/2026 23:12'!generateMapAt: addressOrNull start: startAddress	"Generate the method map at addressOrNull (or compute it if addressOrNull is null).	 Answer the length of the map in bytes."	<var: 'addressOrNull' type: #usqInt>	<var: 'startAddress' type: #usqInt>	<inline: #always>	^self generateMapAt: addressOrNull limit: MaxMethodSize start: startAddress! !!Cogit methodsFor: 'method map' stamp: 'cb 10/26/2026 23:12'!generateMapAt: addressOrNull limit: limit start: startAddress	"Generate the method map at addressOrNull (or compute it if addressOrNull is null),	 writing at most limit bytes.  Answer the length of the map in bytes.  Each entry in	 the map is in two parts.  In the least signficant bits are a displacement of how far	 from the start or previous entry, unless it is an IsAnnotationExtension byte, in	 which case those bits are the extension.  In the most signficant bits are the type	 of annotation at the point reached.  A null byte ends the map."	<var: 'addressOrNull' type: #usqInt>	<var: 'startAddress' type: #usqInt>	| length location |	<var: #instruction type: #'AbstractInstruction *'>	length := 0.	location := startAddress.	0 to: opcodeIndex - 1 do:		[:i| | instruction mcpc delta maxDelta mapEntry |		instruction := self abstractInstructionAt: i.		instruction annotation ifNotNil:			[:annotation|			 literalsManager assertValidAnnotation: annotation for: instruction.			 mcpc := instruction mapEntryAddress.			 [(delta := mcpc - location / backEnd codeGranularity) > DisplacementMask] whileTrue:				[maxDelta := (delta min: MaxX2NDisplacement) bitClear: DisplacementMask.				 self assert: maxDelta >> AnnotationShift <= DisplacementMask.				 (addressOrNull notNil and: [length < limit]) ifTrue:					[self addToMap: IsDisplacementX2N						instruction: instruction						byte: maxDelta >> AnnotationShift + DisplacementX2N						at: addressOrNull - length						for: mcpc].				 location := location + (maxDelta * backEnd codeGranularity).				 length := length + 1].			 (addressOrNull notNil and: [length < limit]) ifTrue:				[mapEntry := delta + ((annotation min: IsSendCall) << AnnotationShift).				 self addToMap: annotation instruction: instruction byte: mapEntry at: addressOrNull - length for: mcpc].			 location := location + (delta * backEnd codeGranularity).			 length := length + 1.			 annotation > IsSendCall ifTrue: "Add the necessary IsAnnotationExtension"				[(addressOrNull notNil and: [length < limit]) ifTrue:					[mapEntry := IsAnnotationExtension << AnnotationShift + (annotation - IsSendCall).					 self addToMap: annotation instruction: instruction byte: mapEntry at: addressOrNull - length for: mcpc].				 length := length + 1]]].	(addressOrNull notNil and: [length < limit]) ifTrue:		[self addToMap: MapEnd instruction: nil byte: MapEnd at: addressOrNull - length for: 0].	^length + 1! !