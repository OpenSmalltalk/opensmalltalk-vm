# Skip mingw-w64 specific configuration flags that should not be required
# when using a clang that targets msvc format.
NOBUILTIN=
CALLING_CONVENTION=
BITFIELD_LAYOUT=
DECLSPEC=

include ../common/Makefile.tools.flags
