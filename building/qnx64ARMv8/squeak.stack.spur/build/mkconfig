#!/bin/sh

int_modules="vm"
ext_modules="vm-display-null vm-display-qnxScreen vm-sound-null"
int_plugins=" `grep -v '^#'  /home/kend/Kens-VM/building/qnx64ARMv8/squeak.stack.spur/build/plugins.int | sed 's/INTERNAL_PLUGINS = //' | tr -d '\\\\\\012';echo`"
ext_plugins=" `grep -v '^#'  /home/kend/Kens-VM/building/qnx64ARMv8/squeak.stack.spur/build/plugins.ext | sed 's/EXTERNAL_PLUGINS = //' | tr -d '\\\\\\012';echo`"

if test -f plugins.exc; then
  nlsp='tr \012\015 \040\040'
  spnl='tr \040\040 \012\012'
  int_modules="`echo ${int_modules} | $spnl | fgrep -v -f plugins.exc | $nlsp`"
  ext_modules="`echo ${ext_modules} | $spnl | fgrep -v -f plugins.exc | $nlsp`"
  int_plugins="`echo ${int_plugins} | $spnl | fgrep -v -f plugins.exc | $nlsp`"
  ext_plugins="`echo ${ext_plugins} | $spnl | fgrep -v -f plugins.exc | $nlsp`"
  exc_plugins="`cat plugins.exc | $nlsp`"
else
  exc_plugins=""
fi

platforms="/home/kend/Kens-VM/platforms"

vmi_conf="${platforms}/unix"
plg_conf="${vmi_conf}/plugins"

vmi_dirs="/home/kend/Kens-VM/src/spur64.stack	${platforms}/Cross			${vmi_conf}"
int_dirs="/home/kend/Kens-VM/src/plugins	${platforms}/Cross/plugins	${plg_conf}"
ext_dirs="/home/kend/Kens-VM/src/plugins	${platforms}/Cross/plugins	${plg_conf}"

cat > config.sh <<EOF
cogit="no"
srcdir="/home/kend/Kens-VM/src/spur64.stack"
blddir="/home/kend/Kens-VM/building/qnx64ARMv8/squeak.stack.spur/build"
topdir="/home/kend/Kens-VM"
cfgdir="/home/kend/Kens-VM/platforms/unix/config"

int_modules="${int_modules}"
ext_modules="${ext_modules}"
int_plugins="${int_plugins}"
ext_plugins="${ext_plugins}"
exc_plugins="${exc_plugins}"

vmi_dirs="${vmi_dirs}"
int_dirs="${int_dirs}"
ext_dirs="${ext_dirs}"
EOF

chmod +x config.sh
