# Makefile for building Nicolas Cellier's development of fdlibm in a remote
# directory.
TP:=../../platforms/Cross/third-party
FDLIBM:=fdlibm
VPATH=$(TP)/$(FDLIBM):.
include $(TP)/$(FDLIBM)/Makefile

# Extra rule for Windows builds using Microsoft VS build tools (i.e., "LIB")
libm.lib : $(obj) 
	$(LIBRARIAN) $(obj) -out:libm.lib
